# Persistent SQLite file for auctions, reservations, and collected emails.
DATABASE_PATH=./data/startup-day-auction.sqlite
PUBLIC_APP_URL=http://localhost:3000

# Protects /admin/reservas and its API. Store the real value in Secret Vault.
ADMIN_ACCESS_TOKEN=

# Test-only time overrides. Never enable them in a public deployment.
# ENABLE_TEST_TIME_OVERRIDES=1
# AUCTION_DURATION_SECONDS=5
# AUCTION_SCHEDULER_INTERVAL_MS=500
