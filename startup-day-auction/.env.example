# Persistent SQLite file for the standalone Node.js server.
DATABASE_PATH=./data/startup-day-auction.sqlite
PUBLIC_APP_URL=http://localhost:3000

# Production payment provider. Inject these with Secret Vault; never commit values.
PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_URL=
MERCADOPAGO_USE_SANDBOX=1
# Optional private proxy used only when the runtime cannot receive the token directly.
# MERCADOPAGO_API_BASE_URL=https://payments-proxy.internal

# Transactional email sent only to the winner after the auction closes.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
AUCTION_FROM_EMAIL=Startup Day <subastas@your-verified-domain.com>

# Test-only overrides used by Playwright. Never enable them in a public deployment.
# PAYMENT_PROVIDER=test
# ENABLE_TEST_PAYMENT_PROVIDER=1
# AUCTION_DURATION_SECONDS=3
# PAYMENT_WINDOW_SECONDS=10
# AUCTION_SCHEDULER_INTERVAL_MS=500
# EMAIL_PROVIDER=test
